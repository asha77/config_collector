AUTH_USERNAME=cisco
AUTH_PASSWORD=cisco2
AUTH_SECONDARY=cisco
AUTH_STRICT_KEY=False
TRANSPORT=ssh2
TIMEOUT_SOCKET=20
TIMEOUT_TRANSPORT=20
# timeout for one operation should be increased to avoid
# ScrapliTimeout "timed out sending input to device" on slow devices or during long operation
TIMEOUT_OPS=60
WORKING_DIRECTORY=
# How may workers doing job in parallel
MAX_WORKERS=10
# Turning on Scrapli debug log into a file (off by default to keep memory)
SCRAPLI_DEBUG_LOG=False
BACKUP_CONFIG_FOLDER='c:\TEMP\configs'
OUTPUT_FOLDER='c:\TEMP\collected_data'
